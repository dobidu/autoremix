{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autoremix/schemas/remix-preset-2.1.json",
  "title": "RemixPreset",
  "description": "Declarative remix mode definition. When effects is non-empty, engine field is ignored and the effect chain interpreter runs instead.",
  "type": "object",
  "required": ["id", "version", "name", "params"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Unique snake_case identifier. Used as engine_id in RemixRequest."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Preset schema version (major.minor)."
    },
    "name": {
      "type": "string",
      "maxLength": 32,
      "description": "Display name shown in UI tab bar."
    },
    "description": {
      "type": "string",
      "maxLength": 256
    },
    "author": {
      "type": "string",
      "maxLength": 64
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 10
    },
    "engine": {
      "type": "string",
      "description": "Registered engine ID (e.g. chopped_screwed). Ignored when effects is non-empty."
    },
    "params": {
      "type": "object",
      "required": [
        "tempo_factor",
        "pitch_shift_semi",
        "reverb_mix",
        "chop_interval_ms",
        "bass_boost_db",
        "drums_tempo_factor"
      ],
      "additionalProperties": false,
      "properties": {
        "tempo_factor":       { "type": "number", "minimum": 0.1,   "maximum": 4.0    },
        "pitch_shift_semi":   { "type": "number", "minimum": -24.0, "maximum": 24.0   },
        "reverb_mix":         { "type": "number", "minimum": 0.0,   "maximum": 1.0    },
        "chop_interval_ms":   { "type": "number", "minimum": 0.0,   "maximum": 10000.0 },
        "bass_boost_db":      { "type": "number", "minimum": -24.0, "maximum": 24.0   },
        "drums_tempo_factor": { "type": "number", "minimum": 0.1,   "maximum": 4.0    }
      }
    },
    "stem_mix": {
      "type": "object",
      "required": ["vocals", "drums", "bass", "other"],
      "additionalProperties": false,
      "properties": {
        "vocals": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "drums":  { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "bass":   { "type": "number", "minimum": 0.0, "maximum": 2.0 },
        "other":  { "type": "number", "minimum": 0.0, "maximum": 2.0 }
      }
    },
    "effects": {
      "type": "array",
      "description": "Effect chain DSL (Phase 10). When non-empty, engine field is ignored and the chain interpreter executes each step in order.",
      "items": {
        "type": "object",
        "required": ["op", "stems", "params"],
        "additionalProperties": false,
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "time_stretch", "pitch_shift", "reverb", "chop", "bass_boost", "eq_highpass",
              "chop_beats", "chop_onsets", "chop_bars", "gate_energy", "structural_cut",
              "saturation", "bitcrusher",
              "delay_pingpong", "delay_tape", "delay_reverse", "delay_dotted",
              "reverb_plate", "reverb_gated", "reverb_reverse",
              "filter_sweep", "vinyl_sim", "sidechain"
            ],
            "description": "Operation to apply. Ops through structural_cut run everywhere; the rest are native-plugin (v5) ops — the Python sidecar skips them with a warning. See design-spec.md for per-op param shapes."
          },
          "stems": {
            "oneOf": [
              {
                "type": "string",
                "enum": ["all", "vocals", "drums", "bass", "other"],
                "description": "'all' applies the op to the summed mix of all stems."
              },
              {
                "type": "array",
                "items": { "type": "string", "enum": ["vocals", "drums", "bass", "other"] },
                "minItems": 1,
                "description": "Apply op only to the listed stem buffers."
              }
            ]
          },
          "params": {
            "type": "object",
            "description": "Op-specific parameters. Runtime-validated by interpreter. See design-spec.md."
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "description": "Structure-aware template (Phase 31-03, native plugin only). Assembles an arrangement of sections anchored to the analyzed song structure.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "arrangement": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "section": {
                "type": "string",
                "description": "Informational label: intro, verse, chorus, drop, outro, ..."
              },
              "length_bars": {
                "type": "integer", "minimum": 0, "default": 0,
                "description": "Slot length in bars. 0 = auto-detect from section boundaries."
              },
              "anchor": {
                "type": "string", "default": "first",
                "description": "Source position in the song: first | second | last | energy_peak | bar:N"
              },
              "loop": {
                "type": "integer", "minimum": 1, "default": 1,
                "description": "Repeat this slot N times before advancing."
              },
              "layer": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "vocals": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
                  "drums":  { "type": "number", "minimum": 0.0, "maximum": 2.0 },
                  "bass":   { "type": "number", "minimum": 0.0, "maximum": 2.0 },
                  "other":  { "type": "number", "minimum": 0.0, "maximum": 2.0 }
                }
              },
              "effects": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Per-slot effect op ids (Phase 35 — parsed now, applied later)."
              }
            }
          }
        },
        "scratch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":       { "type": "boolean", "default": false },
            "position":      { "type": "string", "default": "pre_drop" },
            "style":         { "type": "string", "enum": ["baby", "transformer", "chirp", "forward"], "default": "baby" },
            "duration_bars": { "type": "integer", "minimum": 1, "default": 1 },
            "stem":          { "type": "string", "enum": ["mix", "vocals", "drums", "bass", "other"], "default": "mix" }
          }
        },
        "build_up": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled":      { "type": "boolean", "default": false },
            "length_bars":  { "type": "integer", "minimum": 1, "default": 4 },
            "add_riser":    { "type": "boolean", "default": true },
            "filter_sweep": { "type": "boolean", "default": true }
          }
        },
        "samples": {
          "type": "array",
          "description": "Auto-placed samples from the user library (Phase 33-03).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path":      { "type": "string", "description": "Explicit WAV path; omit to auto-select by category." },
              "placement": { "type": "string", "default": "pre_drop", "description": "pre_drop | drop | vocal_gap | end | bar:N | phrase:N" },
              "category":  { "type": "string", "description": "riser | impact | loop | adlib | fx | one_shot" },
              "gain":      { "type": "number", "minimum": 0.0, "maximum": 2.0, "default": 1.0 },
              "fade_ms":   { "type": "number", "minimum": 0.0, "default": 10.0 }
            }
          }
        }
      }
    }
  }
}
