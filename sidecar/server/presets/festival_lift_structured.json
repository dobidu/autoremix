{
  "id": "festival_lift_structured",
  "version": "2.1",
  "name": "Festival Lift (Structured)",
  "description": "Structure-aware festival edit: stripped intro, full verse, doubled drop anchored to the energy peak, and a fading outro. Auto-places a riser and impact from the sample library when available.",
  "author": "AutoRemix",
  "tags": ["edm", "festival", "structured", "drop", "samples"],
  "engine": "structured_remix",
  "params": {
    "tempo_factor": 1.0,
    "pitch_shift_semi": 0.0,
    "reverb_mix": 0.10,
    "chop_interval_ms": 0.0,
    "bass_boost_db": 0.0,
    "drums_tempo_factor": 1.0
  },
  "stem_mix": { "vocals": 1.0, "drums": 1.0, "bass": 1.0, "other": 1.0 },
  "effects": [],
  "structure": {
    "enabled": true,
    "arrangement": [
      { "section": "intro", "length_bars": 4, "anchor": "first",
        "layer": { "vocals": 0.8, "drums": 0.6, "bass": 0.0, "other": 0.6 } },
      { "section": "verse", "length_bars": 8, "anchor": "second",
        "layer": { "vocals": 1.0, "drums": 1.0, "bass": 1.0, "other": 0.9 } },
      { "section": "drop", "length_bars": 8, "anchor": "energy_peak", "loop": 2,
        "layer": { "vocals": 0.6, "drums": 1.4, "bass": 1.5, "other": 1.0 } },
      { "section": "outro", "length_bars": 4, "anchor": "last",
        "layer": { "vocals": 0.7, "drums": 0.5, "bass": 0.6, "other": 0.5 } }
    ],
    "samples": [
      { "category": "riser",  "placement": "pre_drop", "gain": 0.9, "fade_ms": 250 },
      { "category": "impact", "placement": "drop",     "gain": 1.0, "fade_ms": 10  }
    ],
    "scratch":  { "enabled": false },
    "build_up": { "enabled": false }
  }
}
